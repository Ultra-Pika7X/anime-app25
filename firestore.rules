rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: For this demo with client-side AniList Auth, we are allowing public access.
    // In a real app with a backend, we would mint Custom Firebase Tokens for AniList users.
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
